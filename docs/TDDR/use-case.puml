  usecase "Subir audio y\ntranscribir" as uc11
  usecase "Editar transcripción" as uc12
  usecase "Generar borrador" as uc13
  usecase "Generar borrador con LLM" as uc14
  usecase "Editar borrador" as uc15
  usecase "Cambiar estado\ndel informe" as uc16
  usecase "Exportar PDF / DOCX" as uc17
  usecase "Consultar dashboard\nde productividad" as uc18
  usecase "Consultar historial\nde estados" as uc19
}

cliente --> uc1

inspector --> uc2
inspector --> uc6
inspector --> uc7
inspector --> uc8
inspector --> uc9
inspector --> uc10
inspector --> uc11
inspector --> uc12
inspector --> uc13
inspector --> uc14
inspector --> uc15
inspector --> uc16
inspector --> uc17
inspector --> uc18
inspector --> uc19

admin --> uc2
admin --> uc3
admin --> uc4
admin --> uc5
admin --> uc6
admin --> uc18
admin --> uc19

viewer --> uc2
