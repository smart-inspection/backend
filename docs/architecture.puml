@startuml
title Smart Inspection - Arquitectura actual desplegada

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 30

actor "Inspector / Usuario" as user

node "Cliente" {
  node "Navegador Web" as browser
  artifact "Frontend SPA\nReact + TypeScript + Vite\nReact Router + TanStack Query" as frontend
}

node "Servidor de Aplicación" {
  node "FastAPI API\nUvicorn\n127.0.0.1:8000" as api {
    component "Routers API v1" as routers
    component "Inspections" as inspections
    component "Inspection Fields" as fields
    component "Evidences" as evidences
    component "OCR" as ocr
    component "Transcription" as transcription
    component "Report Drafts" as drafts
    component "LLM Report" as llmreport
    component "Report Export\nDOCX / PDF" as export
    component "Report Status" as reportstatus
    component "Inspection Enrichment" as enrichment
    component "StaticFiles\n/api/v1/uploads" as staticfiles
  }

  folder "Uploads locales\nEvidencias / imágenes / archivos" as uploads

  database "Base de Datos\nSQLAlchemy Engine\nDATABASE_URL (.env)" as db

  node "Servicios OCR" as ocrstack {
    component "PaddleOCR" as paddle
    component "Tesseract OCR" as tesseract
    component "Validación OCR\nplaca / VIN / serie / numéricos" as validation
  }

  node "Servicios IA" as aistack {
    component "Ollama\nlocalhost:11434" as ollama
    component "Modelo llama3" as llama3
  }

  node "Procesamiento de reportes" as reportstack {
    component "python-docx" as docx
    component "ReportLab PDF" as pdf
  }
}

user --> browser
browser --> frontend : UI de inspecciones
frontend --> api : HTTP / REST\nVITE_API_BASE_URL

routers --> inspections
routers --> fields
routers --> evidences
routers --> ocr
routers --> transcription
routers --> drafts
routers --> llmreport
routers --> export
routers --> reportstatus
routers --> enrichment
routers --> staticfiles

inspections --> db
fields --> db
evidences --> db
transcription --> db
drafts --> db
reportstatus --> db
enrichment --> db

evidences --> uploads : guarda archivos
staticfiles --> uploads : expone archivos
ocr --> uploads : lee imágenes
transcription --> uploads : lee audio/archivo fuente
export --> uploads : usa imágenes/evidencias
export --> db : arma contexto del reporte

ocr --> paddle
ocr --> tesseract
ocr --> validation
validation --> db

llmreport --> ollama
ollama --> llama3
llmreport --> db

export --> docx
export --> pdf

note right of frontend
Rutas SPA visibles:
Dashboard, Inspecciones,
Evidencias e Informes
end note

note right of api
Routers montados bajo /api/v1
CORS habilitado para localhost:5173
Uploads servidos en /api/v1/uploads
end note

@enduml