@startuml
title Diagrama de actividad

start

:Iniciar sesión;

if (¿Credenciales válidas?) then (Sí)
  :Mostrar dashboard;
else (No)
  :Mostrar mensaje de error;
  stop
endif

:Crear inspección o convertir solicitud;
:Registrar datos generales del equipo;
:Registrar campos estructurados;
:Cargar evidencias fotográficas;

if (¿Se requiere extraer texto?) then (Sí)
  :Ejecutar OCR;
  :Revisar resultado OCR;
  :Actualizar campos técnicos;
endif

if (¿Existen observaciones de voz?) then (Sí)
  :Grabar o cargar audio;
  :Ejecutar transcripción;
  :Corregir texto final;
endif

:Iniciar medición de productividad;
:Generar borrador de informe con IA;
:Revisar y editar borrador;
:Cambiar estado a finalizado;
:Finalizar medición de productividad;
:Exportar informe en PDF o DOCX;

stop
@enduml