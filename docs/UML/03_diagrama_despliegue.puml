@startuml
title Diagrama de despliegue — Smart Inspect

node "Dispositivo del usuario" {
  artifact "Navegador web" as browser
}

cloud "Internet" as internet

node "Hosting del frontend" {
  artifact "Aplicación React\nVite compilada" as frontend
}

node "Servidor de aplicación" {
  artifact "FastAPI + Uvicorn" as backend
  folder "uploads/" as uploads
}

database "PostgreSQL\nBase de datos" as database

node "Servidor de IA" {
  artifact "PaddleOCR" as paddle_ocr
  artifact "Tesseract" as tesseract
  artifact "Whisper" as whisper
  artifact "Ollama + LLaMA 3" as ollama
}

browser --> internet
internet --> frontend : HTTPS
frontend --> backend : API REST / HTTPS
backend --> database : SQLAlchemy / SQL
backend --> uploads : Archivos de evidencia
backend --> paddle_ocr : Procesamiento OCR
backend --> tesseract : OCR complementario
backend --> whisper : Transcripción de audio
backend --> ollama : Generación de borrador
@enduml