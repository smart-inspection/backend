@startuml
title Diagrama de casos de uso — Smart Inspect
left to right direction
skinparam packageStyle rectangle

actor "Empresa cliente" as cliente
actor "Inspector" as inspector
actor "Administrador" as admin
actor "Visualizador" as viewer

rectangle "Sistema Smart Inspect" {
  usecase "Registrar solicitud\npública" as uc_solicitud
  usecase "Iniciar sesión" as uc_login
  usecase "Consultar dashboard\nde productividad" as uc_dashboard
  usecase "Gestionar solicitudes" as uc_gestionar_solicitudes
  usecase "Convertir solicitud\na inspección" as uc_convertir
  usecase "Crear inspección" as uc_crear_inspeccion
  usecase "Consultar inspecciones" as uc_consultar_inspecciones
  usecase "Registrar campos\nestructurados" as uc_campos
  usecase "Cargar evidencias" as uc_evidencias
  usecase "Ejecutar OCR" as uc_ocr
  usecase "Registrar transcripción\nde audio" as uc_transcripcion
  usecase "Generar borrador\ncon IA" as uc_borrador
  usecase "Cambiar estado\ndel informe" as uc_estado
  usecase "Exportar informe\nPDF/DOCX" as uc_exportar
  usecase "Gestionar usuarios" as uc_usuarios
  usecase "Consultar informes" as uc_informes
}

cliente --> uc_solicitud

inspector --> uc_login
inspector --> uc_crear_inspeccion
inspector --> uc_consultar_inspecciones
inspector --> uc_campos
inspector --> uc_evidencias
inspector --> uc_ocr
inspector --> uc_transcripcion
inspector --> uc_borrador
inspector --> uc_estado
inspector --> uc_exportar
inspector --> uc_dashboard

admin --> uc_login
admin --> uc_dashboard
admin --> uc_gestionar_solicitudes
admin --> uc_convertir
admin --> uc_crear_inspeccion
admin --> uc_consultar_inspecciones
admin --> uc_informes
admin --> uc_usuarios

viewer --> uc_login
viewer --> uc_dashboard
viewer --> uc_gestionar_solicitudes
viewer --> uc_consultar_inspecciones
viewer --> uc_informes

uc_convertir .> uc_gestionar_solicitudes : <<extend>>
uc_ocr .> uc_evidencias : <<include>>
uc_borrador .> uc_campos : <<include>>
uc_borrador .> uc_ocr : <<include>>
uc_borrador .> uc_transcripcion : <<include>>
uc_exportar .> uc_estado : <<include>>
@enduml